# Set these values in Hostinger, not in browser code or NEXT_PUBLIC variables.
APP_URL=https://your-assigned-domain.example
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_in_hostinger
DB_USER=replace_in_hostinger
DB_PASSWORD=replace_in_hostinger
# Local database can use the private local connection. Remote hosts require TLS.
DB_SSL=false
# Enable only while creating test accounts; disable again after testing.
REGISTRATION_ENABLED=false
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
# Enable only AFTER applying database/013-saas-workspaces.sql and validating
# backups, email verification, tenant isolation and the payment integration.
# New installations use schema.sql instead of migration 013.
SAAS_ENABLED=false
# Apply 014, 015 and 016 after 013 for existing databases. Fresh databases use schema.sql only.
# Keep billing disabled until sandbox tests and provider setup are verified.
BILLING_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Separate deliberate opt-in for REAL recurring payments.
LIVE_PAYMENTS_ENABLED=false
# Enable verification enforcement only after testing email delivery.
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional natural-language interpretation. Keep the key server-side in Hostinger.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ASSISTANT_MEDIA_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
