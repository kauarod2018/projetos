# Copie para .env e preencha. Nada aqui é obrigatório, mas cada chave libera recursos.

# Google (você já tem): Gemini para roteiros/avaliação
# Crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# Google Cloud: YouTube Data API v3 (grátis, 10.000 unidades/dia)
# Crie em https://console.cloud.google.com/apis/credentials (ative "YouTube Data API v3")
# Sem ela a busca usa o yt-dlp (funciona, mas com menos dados: sem inscritos/likes)
YOUTUBE_API_KEY=

# Bancos de vídeo/imagem gratuitos (uso comercial liberado)
# https://www.pexels.com/api/   e   https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voz gratuita (Edge-TTS). Outras: pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural
VOZ_PADRAO=pt-BR-AntonioNeural
REGIAO_PADRAO=BR
IDIOMA_PADRAO=pt
